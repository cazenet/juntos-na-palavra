rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPrimaryAdmin() {
      return signedIn()
        && request.auth.token.email == 'cazenet10@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved';
    }
    function isAdmin() {
      return isPrimaryAdmin() || (isApproved()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin');
    }
    match /members/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','status','role','createdAt','updatedAt'])
        && ((request.resource.data.status == 'pending' && request.resource.data.role == 'participant')
          || (isPrimaryAdmin() && request.resource.data.status == 'approved' && request.resource.data.role == 'admin'));
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','role','updatedAt'])
        && request.resource.data.status in ['pending','approved','rejected']
        && request.resource.data.role in ['participant','admin'];
      allow delete: if isAdmin() && uid != request.auth.uid;
    }
    match /reflections/{reflectionId} {
      function validReflection() {
        return request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.visibility in ['private','shared']
          && request.resource.data.noticed is string
          && request.resource.data.learned is string
          && request.resource.data.application is string
          && request.resource.data.noticed.size() <= 3000
          && request.resource.data.learned.size() <= 3000
          && request.resource.data.application.size() <= 3000
          && request.resource.data.keys().hasOnly(['ownerUid','ownerName','noticed','learned','application','visibility','planId','planTitle','week','updatedAt']);
      }
      allow create: if isApproved() && validReflection()
        && reflectionId == request.auth.uid + '_' + request.resource.data.planId + '_' + string(request.resource.data.week);
      allow get: if signedIn() && (
        (resource == null && reflectionId.matches('^' + request.auth.uid + '_.*'))
        || resource.data.ownerUid == request.auth.uid
        || (isApproved() && resource.data.visibility == 'shared')
      );
      allow list: if isApproved() && resource.data.visibility == 'shared';
      allow update: if isApproved() && resource.data.ownerUid == request.auth.uid
        && validReflection() && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.planId == resource.data.planId && request.resource.data.week == resource.data.week;
      allow delete: if isApproved() && resource.data.ownerUid == request.auth.uid;

      match /comments/{commentId} {
        function parentIsOwnedByCaller() {
          return exists(/databases/$(database)/documents/reflections/$(reflectionId))
            && get(/databases/$(database)/documents/reflections/$(reflectionId)).data.ownerUid == request.auth.uid;
        }
        function parentIsShared() {
          return exists(/databases/$(database)/documents/reflections/$(reflectionId))
            && get(/databases/$(database)/documents/reflections/$(reflectionId)).data.visibility == 'shared';
        }
        allow read: if isApproved() && parentIsShared();
        allow create: if isApproved() && parentIsShared()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerName is string
          && request.resource.data.photoURL is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(['ownerUid','ownerName','photoURL','text','createdAt']);
        allow update: if false;
        allow delete: if isApproved() && (resource.data.ownerUid == request.auth.uid || isAdmin() || parentIsOwnedByCaller());
      }
    }
    match /plans/{planId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
      match /progress/{uid} {
        allow read: if isApproved() && (request.auth.uid == uid || isAdmin());
        allow create, update: if isApproved() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid','completed','updatedAt'])
          && request.resource.data.completed is list;
        allow delete: if isAdmin() || (isApproved() && request.auth.uid == uid);
      }
    }
  }
}
